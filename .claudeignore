# ============================================================
# Python (Backend)
# ============================================================

# Виртуальные окружения
venv/
.venv/
env/
ENV/

# Кэш и скомпилированные файлы
__pycache__/
*.py[cod]
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/

# Артефакты сборки и пакеты
dist/
build/
*.egg-info/
*.whl
*.so

# Логи и базы данных
*.log
*.db
*.sqlite
*.sqlite3

# ============================================================
# Vue.js (Frontend)
# ============================================================

# Зависимости (node_modules — самый большой)
node_modules/
frontend/node_modules/

# Артефакты сборки (сгенерированные файлы)
dist/
build/
out/
frontend/dist/
frontend/build/

# Минифицированные файлы (сгенерированный код)
*.min.js
*.min.css
*.bundle.js
*.chunk.js
*.vendor.js
*.polyfills.js

# ============================================================
# Общее для всех языков
# ============================================================

# Файлы окружения с секретами
.env
.env.*
*.local
secrets/
credentials/
*.pem
*.key
*.cert

# IDE и редакторы
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Временные файлы и кэш
tmp/
temp/
.cache/
*.tmp
*.temp

# Система контроля версий (обычно не нужно, но для ясности)
.git/

# ============================================================
# Что включать (для ясности)
# ============================================================
# Исходный код Python (ваш бекенд)
# Исходный код Vue (папка src/)
# Файлы конфигурации (pyproject.toml, package.json, vite.config.js)
# Документация (README.md, docs/)