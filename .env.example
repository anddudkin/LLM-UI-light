# Used by docker-compose.yml (docker compose auto-loads ".env" next to this file).
# Copy to .env and adjust if needed — these also have inline defaults in docker-compose.yml,
# so a .env file here is optional.
POSTGRES_USER=llm_ui_light
POSTGRES_PASSWORD=llm_ui_light
POSTGRES_DB=llm_ui_light
POSTGRES_PORT=5432

# Host path where uploaded files, chat cache, and per-user data are persisted. No safe
# default (host path) — REQUIRED for `docker compose up backend` to start.
LOCAL_STORAGE_HOST_PATH=./local_storage

# backend service — LOCAL_LLM_URL and LLM_MODEL_NAME have no safe default (point at your
# self-hosted OpenAI-compatible LLM server) and are REQUIRED for `docker compose up backend`.
BACKEND_PORT=8010
LOCAL_LLM_URL=http://host.docker.internal:8000
LLM_MODEL_NAME=your-model-name
# Should point at the frontend's origin (FRONTEND_PORT below).
REDIRECT_URL=http://localhost:5173
# REQUIRED, no safe default — signs/encrypts the /api/sso login handoff token. Generate your
# own with `openssl rand -hex 32`; never reuse the example/documented value in production.
SSO_SECRET_KEY=
# Unset (default) disables automatic chat cleanup; set to a number of days to enable it.
CHAT_RETENTION_DAYS=

# searxng service — used by backend's web_search() tool as its primary search backend
# (see SEARXNG_URL, hardcoded to the internal docker-network address in docker-compose.yml).
SEARXNG_PORT=8080
# Timeout (seconds) for the SearXNG search request; falls back to ddgs on timeout.
SEARXNG_TIMEOUT=5
# Max characters of extracted page text kept per web_search() result before it reaches the model.
SEARCH_PAGE_CHAR_LIMIT=1500

# frontend service — VITE_API_BASE_URL is baked into the image at build time (Vite inlines
# VITE_* vars into the built bundle), so changing it requires rebuilding the frontend image.
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8010
